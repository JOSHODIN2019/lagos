# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

# Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# JWT signing secret — MUST be changed to a long random value before this
# app is ever exposed beyond localhost. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-value

# Ollama (Stage 8 AI Query Interpreter) — defaults match a local
# `brew services start ollama` setup, no paid API involved.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Comma-separated, case-insensitive allowlist of admin emails (Stage 9).
# Empty by default — no one has admin access until this is set.
ADMIN_EMAILS=

# Comma-separated list of exact frontend origins allowed to call this API.
# Leave unset in local dev to fall back to the permissive localhost regex;
# set explicitly before deploying anywhere beyond localhost.
CORS_ORIGINS=
